<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the OS treat the app as a camera-capable handler (quick-launch / default-camera lists). -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!-- Declared explicitly so OEM camera / resolver pickers can treat the app as camera-capable. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Dangerous / runtime: each must have a matching step in WelcomeFlowConfig.runtimePermissionSteps -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- API 28 and below: MediaStore video insert requires legacy write access. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Required for the 30 ms post-readout still-capture tick (CaptureHaptics).
         Vibrator does not require runtime permission - the manifest entry is
         sufficient. Video start/stop deliberately never vibrates. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Optional: silence interruptions while recording when the user enables the feature
         and grants access in system Settings (Notification policy). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Sprint IP.2 — LAN media transfer + optional social webhook POST -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Sprint 15.37 — LAN tether discovery (NSD / Wi‑Fi Direct companion) -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <application
        android:name=".PnsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/pns_data_extraction_rules"
        android:fullBackupContent="@xml/pns_backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Point &amp; Shoot"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:supportsRtl="true">

        <!-- Lets Macrobenchmark / BaselineProfile read GPU framestats on release-class builds (API 31+). -->
        <profileable android:shell="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Point &amp; Shoot"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:clearTaskOnLaunch="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- System "external camera app" / quick-launch (e.g. double-press power) resolves these; show in app picker.
                 MAIN action + LAUNCHER category required for some OEMs to list as default camera option. -->
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.VIDEO_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.VIDEO_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.IMAGE_CAPTURE_SECURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Lockscreen quick-launch camera (secure device, e.g. double-press power when locked). -->
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA_SECURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Other apps / system "take picture" — caller expects [setResult] + JPEG per [MediaStore.ACTION_IMAGE_CAPTURE]. -->
            <intent-filter>
                <action android:name="android.media.action.IMAGE_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Sprint IP.1 — deep links (e.g. pointandshoot://preview) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pointandshoot" android:host="preview" />
                <data android:scheme="pointandshoot" android:host="camera" />
                <data android:scheme="pointandshoot" android:host="video" />
                <data android:scheme="pointandshoot" android:host="gallery" />
                <data android:scheme="pointandshoot" android:host="share" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ShareReceiveActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="dev.pointandshoot.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/pns_file_paths" />
        </provider>

        <receiver
            android:name=".PnsCameraWidgetProvider"
            android:exported="true"
            android:label="@string/pns_widget_camera_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pns_widget_camera_info" />
        </receiver>

        <!-- Quick Settings tiles for one-tap camera access (Android 7.0+). -->
        <service
            android:name=".quicksettings.CameraTileService"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Camera"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".quicksettings.VideoTileService"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Video"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".quicksettings.SelfieTileService"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Selfie"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>

