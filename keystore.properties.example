# Copy this file to `keystore.properties` (gitignored) at the REPO ROOT to enable
# real release-signing locally. `/ship` and `pns_github_release.ps1 -Publish` require
# this file or ANDROID_KEYSTORE_* env vars — they will not upload a debug-key APK.
# NEVER commit `keystore.properties` or the keystore itself.
#
# Paths are resolved relative to the repo root; absolute paths also work.
# The CI workflow (.github/workflows/build-signed.yml) does NOT use this file -
# it provides the same four values via environment variables instead:
#   ANDROID_KEYSTORE_PATH / ANDROID_KEYSTORE_PASSWORD / ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD
#
# Preferred: .\scripts\pns_release_signing_bootstrap.ps1 -SetGitHubSecrets -UpdateExpectedJson
# Manual generate:
#   keytool -genkeypair -v \
#     -keystore release.keystore \
#     -alias pns-release \
#     -keyalg RSA -keysize 4096 -validity 36500 \
#     -storetype PKCS12

storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=pns-release
keyPassword=CHANGE_ME
