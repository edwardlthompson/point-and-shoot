<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the OS treat the app as a camera-capable handler (quick-launch / default-camera lists). -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Dangerous / runtime: each must have a matching step in WelcomeFlowConfig.runtimePermissionSteps -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Required for the 30 ms post-readout still-capture tick (CaptureHaptics).
         Vibrator does not require runtime permission - the manifest entry is
         sufficient. Video start/stop deliberately never vibrates. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Optional: silence interruptions while recording when the user enables the feature
         and grants access in system Settings (Notification policy). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <application
        android:name=".PnsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/pns_data_extraction_rules"
        android:fullBackupContent="@xml/pns_backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Point &amp; Shoot"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:supportsRtl="true">

        <!-- Lets Macrobenchmark / BaselineProfile read GPU framestats on release-class builds (API 31+). -->
        <profileable android:shell="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Point &amp; Shoot"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- System "open camera" / quick-launch (e.g. double-press power) resolves these; show in app picker. -->
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.VIDEO_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.IMAGE_CAPTURE_SECURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Other apps / system "take picture" — caller expects [setResult] + JPEG per [MediaStore.ACTION_IMAGE_CAPTURE]. -->
            <intent-filter>
                <action android:name="android.media.action.IMAGE_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>

