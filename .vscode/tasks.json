{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "P&S: local parallel host (Tier 0)",
      "type": "shell",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/pns_local_dev_parallel.ps1",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": false },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "P&S: prerelease host (Tier 1)",
      "type": "shell",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/pns_prerelease_gate.ps1 -SkipGradle",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "P&S: toolchain + tests (Tier 2)",
      "type": "shell",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/pns_verify_toolchain.ps1 -RunTests",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "P&S: prerelease full (Tier 4 host)",
      "type": "shell",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/pns_prerelease_gate.ps1",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Leaderboard: open preview",
      "type": "shell",
      "command": "echo ${input:openLeaderboardPreview}",
      "presentation": {
        "reveal": "never",
        "echo": false,
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Leaderboard: start server",
      "type": "shell",
      "command": "python -m http.server 8765",
      "options": {
        "cwd": "${workspaceFolder}/docs"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Serving HTTP"
        }
      }
    }
  ],
  "inputs": [
    {
      "id": "openLeaderboardPreview",
      "type": "command",
      "command": "simpleBrowser.api.open",
      "args": ["http://127.0.0.1:8765/leaderboard/"]
    }
  ]
}
