<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ cloud backup and device-to-device transfer (same prefs allow-list as fullBackupContent). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="pns_preview_chrome.xml" />
        <include domain="sharedpref" path="pns_hud_settings.xml" />
        <include domain="sharedpref" path="pns_welcome_flow.xml" />
        <include domain="sharedpref" path="pns_diagnostics.xml" />
        <include domain="sharedpref" path="pns_vendor_highlight_ae.xml" />
        <include domain="sharedpref" path="pns_root_capability.xml" />
        <include domain="sharedpref" path="pns_composition_guides.xml" />
        <include domain="sharedpref" path="pns_ui_hints.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="pns_preview_chrome.xml" />
        <include domain="sharedpref" path="pns_hud_settings.xml" />
        <include domain="sharedpref" path="pns_welcome_flow.xml" />
        <include domain="sharedpref" path="pns_diagnostics.xml" />
        <include domain="sharedpref" path="pns_vendor_highlight_ae.xml" />
        <include domain="sharedpref" path="pns_root_capability.xml" />
        <include domain="sharedpref" path="pns_composition_guides.xml" />
        <include domain="sharedpref" path="pns_ui_hints.xml" />
    </device-transfer>
</data-extraction-rules>
